# openai (the default) or anthropic. The app reads this file when it starts, and a packaged app reads it from its user data folder.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: overrides the provider's default model.
LLM_MODEL=
# Optional: overrides the cheap model that names chats.
LLM_TITLE_MODEL=
# The mascot Gallery's server. Left empty, the Gallery shows only what comes with the app, and there's no sign-in.
SUPABASE_URL=
# The publishable key, starting sb_publishable_. Never the secret key.
SUPABASE_PUBLISHABLE_KEY=
# Where site/ is deployed, for the link to a mascot's public page.
BLUEBERRY_SITE_URL=
# Optional: a Firecrawl key, for Berry's web_search tool. Left empty, Berry searches by opening a search page.
FIRECRAWL_API_KEY=
