{
  "name": "blueberry-browser",
  "version": "1.0.0",
  "description": "An AI browser that works on your behalf, with a flock of birds for the jobs you repeat",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "author": "Ludwig Forsberg",
  "homepage": "https://github.com/Luddeforsberg/blueberry-browser",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "electron-vite build && playwright test -c evals/playwright.config.ts",
    "site:build": "node scripts/buildSite.mjs",
    "site:deploy": "npx netlify deploy --prod --dir site",
    "push:keys": "node scripts/pushKeys.mjs",
    "runner:build": "esbuild runner/src/index.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=runner/dist/index.cjs",
    "runner:start": "node runner/dist/index.cjs",
    "verify": "npm run typecheck && npm run lint && npm run test && electron-vite build && npm run test:e2e",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/openai": "^1.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "dotenv": "^17.2.2",
    "express": "5.3.0",
    "langchain": "^1.6.0",
    "lucide-react": "^0.544.0",
    "playwright-core": "1.64.1",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "web-push": "3.6.7",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "5.0.3",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@xyflow/react": "12.12.0",
    "autoprefixer": "^10.4.21",
    "chart.js": "4.5.1",
    "clsx": "^2.1.1",
    "electron": "^45.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
